# Copie para .env e preencha. O .env esta no .gitignore — nunca comite credencial.

# Credenciais do app OAuth 2.0 (3LO) registrado em developer.atlassian.com. Basic Auth com
# token de conta (com ou sem escopo) nao aplica escopo de verdade no Jira Cloud — so OAuth
# 2.0 respeita read:jira-work / write:jira-work / read:jira-user de verdade. Todas obrigatorias.
JIRA_OAUTH_CLIENT_ID=coloque_o_client_id_aqui
JIRA_OAUTH_CLIENT_SECRET=coloque_o_client_secret_aqui

# Id do site Jira Cloud (cloudId), obtido em GET https://api.atlassian.com/oauth/token/accessible-resources
# apos o primeiro consentimento OAuth.
JIRA_OAUTH_CLOUD_ID=coloque_o_cloud_id_aqui

# Refresh token obtido no fluxo de autorizacao (authorization code grant). A Atlassian roda
# (rotate) esse valor a cada renovacao de access token — a aplicacao reescreve esta linha
# automaticamente no .env a cada renovacao, entao o valor aqui e so o ponto de partida.
JIRA_OAUTH_REFRESH_TOKEN=coloque_o_refresh_token_aqui

# Projeto usado quando a requisicao nao informa um. Padrao: KAN.
JIRA_DEFAULT_PROJECT_KEY=KAN

# Id do tipo de item usado para subtarefas. Em branco, e descoberto em runtime
# lendo os tipos do projeto. Preencha so quando o projeto tem mais de um tipo de
# subtarefa e a descoberta escolhe o errado.
JIRA_SUBTASK_ISSUE_TYPE_ID=

# Id do campo customizado Worker (ex.: customfield_10073). Em branco, e descoberto
# em runtime lendo os campos da instancia e casando pelo nome "Worker". Preencha so
# quando o campo foi renomeado ou existe mais de um com esse nome.
JIRA_WORKER_FIELD_ID=

# Porta HTTP do servico. Padrao: 8080.
SERVER_PORT=8080
