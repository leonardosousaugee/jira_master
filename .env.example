# Copie para .env e preencha. O .env esta no .gitignore — nunca comite credencial.

# URL da instancia Jira Cloud. Obrigatoria.
JIRA_BASE_URL=https://juditecompany.atlassian.net

# E-mail da conta Atlassian usada na autenticacao. Obrigatoria.
JIRA_EMAIL=seu.email@empresa.com.br

# API token da conta, gerado em:
# https://id.atlassian.com/manage-profile/security/api-tokens
# Obrigatoria.
JIRA_API_TOKEN=coloque_o_token_aqui

# Projeto usado quando a requisicao nao informa um. Padrao: KAN.
JIRA_DEFAULT_PROJECT_KEY=KAN

# Id do tipo de item usado para subtarefas. Em branco, e descoberto em runtime
# lendo os tipos do projeto. Preencha so quando o projeto tem mais de um tipo de
# subtarefa e a descoberta escolhe o errado.
JIRA_SUBTASK_ISSUE_TYPE_ID=

# Porta HTTP do servico. Padrao: 8080.
SERVER_PORT=8080
